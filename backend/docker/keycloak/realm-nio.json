{
  "realm": "nio",
  "enabled": true,
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "sslRequired": "external",
  "roles": {
    "realm": [
      {
        "name": "client",
        "description": "Salon customer"
      },
      {
        "name": "employee",
        "description": "Salon staff"
      },
      {
        "name": "admin",
        "description": "Administrator"
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      },
      {
        "name": "default-roles-nio",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization",
            "client"
          ],
          "client": {
            "account": [
              "view-profile",
              "manage-account"
            ]
          }
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-nio",
    "composite": true
  },
  "clients": [
    {
      "clientId": "nio-frontend",
      "name": "Nio Esthétique frontend",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:5173",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      }
    }
  ],
  "users": [
    {
      "username": "client1",
      "email": "client1@example.com",
      "firstName": "Client",
      "lastName": "One",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-nio",
        "client"
      ]
    },
    {
      "username": "employee1",
      "email": "employee1@example.com",
      "firstName": "Employee",
      "lastName": "One",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-nio",
        "employee"
      ]
    },
    {
      "username": "admin1",
      "email": "admin1@example.com",
      "firstName": "Admin",
      "lastName": "One",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-nio",
        "admin"
      ]
    }
  ]
}
