# Rehearsal of the production stack on a workstation (docs/operations.md, "Staging run"). Throwaway values
# only: nothing here is a real secret. *.localhost resolves to this machine; Caddy uses its own local CA for it.
NIO_SITE_DOMAIN=nio.localhost
NIO_AUTH_DOMAIN=auth.nio.localhost
NIO_ACME_EMAIL=staging@nio.localhost
NIO_CADDY_EXTRA_GLOBAL=local_certs
# images are built locally (--build) under this tag
NIO_IMAGE_TAG=staging

POSTGRES_PASSWORD=staging-postgres
NIO_DB_PASSWORD=staging-app
KEYCLOAK_DB_PASSWORD=staging-keycloak

KC_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=staging-admin
# Mailpit from deploy/compose.staging.yaml (web UI on http://localhost:8025)
NIO_SMTP_HOST=mailpit
NIO_SMTP_PORT=1025
NIO_SMTP_FROM=no-reply@nio.localhost
NIO_SMTP_USER=staging
NIO_SMTP_PASSWORD=staging
# Google's published test keys: the checkbox always passes
NIO_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
NIO_RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# SeaweedFS from deploy/compose.staging.yaml stands in for the managed bucket
NIO_S3_ENDPOINT=http://s3:8333
NIO_S3_PUBLIC_ENDPOINT=http://localhost:8333
NIO_S3_REGION=us-east-1
NIO_S3_BUCKET=nio-media
NIO_S3_ACCESS_KEY=nio-dev
NIO_S3_SECRET_KEY=nio-dev-secret
