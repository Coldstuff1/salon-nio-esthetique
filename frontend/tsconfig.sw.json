// The service worker runs in a worker, not a page: it gets the WebWorker library instead of the DOM.
{
  "extends": "@vue/tsconfig/tsconfig.json",
  "include": ["src/sw.ts", "src/swMessages.ts"],
  "compilerOptions": {
    "lib": ["ESNext", "WebWorker"],
    "types": [],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.sw.tsbuildinfo"
  }
}
