# Production settings for compose.prod.yaml and deploy/backup.sh.
# Copy to .env.prod on the server, fill in every value, and `chmod 600 .env.prod`. Never commit the copy.
# Generate each password/secret with: openssl rand -base64 32 | tr -d '/+='
# Keep values on one line, without quotes or spaces.

# --- public hostnames (DNS A/AAAA records point at the server) ---
NIO_SITE_DOMAIN=salon-nio.ca
NIO_AUTH_DOMAIN=auth.salon-nio.ca
# Let's Encrypt sends certificate expiry warnings here
NIO_ACME_EMAIL=
# leave empty in production
NIO_CADDY_EXTRA_GLOBAL=

# --- Postgres (one server, separate databases and roles for the app and Keycloak) ---
# superuser: used only by the init script, backups and maintenance
POSTGRES_PASSWORD=
NIO_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=

# --- Keycloak ---
# temporary admin for the very first sign-in; replace it as described in docs/operations.md
KC_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
# transactional email provider (Keycloak's verification and password-reset emails, the backend's notification
# emails); STARTTLS on port 587
NIO_SMTP_HOST=
NIO_SMTP_PORT=587
NIO_SMTP_FROM=no-reply@salon-nio.ca
NIO_SMTP_USER=
NIO_SMTP_PASSWORD=
# reCAPTCHA v2 checkbox keys for the registration page (https://www.google.com/recaptcha/admin)
NIO_RECAPTCHA_SITE_KEY=
NIO_RECAPTCHA_SECRET_KEY=

# --- media bucket (managed S3; keep it in Canada) ---
NIO_S3_ENDPOINT=https://s3.ca-central-1.amazonaws.com
# only when browsers reach the bucket at a different address than the backend does
NIO_S3_PUBLIC_ENDPOINT=
NIO_S3_REGION=ca-central-1
NIO_S3_BUCKET=
# a key limited to this bucket: GetObject, PutObject, DeleteObject
NIO_S3_ACCESS_KEY=
NIO_S3_SECRET_KEY=

# --- backups (deploy/backup.sh): a different bucket, with its own key ---
RESTIC_REPOSITORY=s3:https://s3.ca-central-1.amazonaws.com/<backup-bucket>/nio
# losing this password makes the backups unreadable: keep a copy offline
RESTIC_PASSWORD=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
